# Server-only. Read by the /api/chat route and scripts/generate_assets.py. Never prefix with EXPO_PUBLIC_.
GEMINI_API_KEY=
# Optional: override the text model (default gemini-3.5-flash).
GEMINI_TEXT_MODEL=
# For native release builds: where the /api routes are deployed, e.g. https://kinship.expo.app
EXPO_PUBLIC_API_URL=
